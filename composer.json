{
    "name": "billto/billto-woocommerce",
    "description": "BillTo for WooCommerce - development dependencies only; the plugin has no runtime Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.36",
        "php-stubs/woocommerce-stubs": "^9.5",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "BillTo\\WooCommerce\\": "includes/",
            "BillTo\\WooCommerce\\Tests\\": "tests/",
            "BillTo\\Shop\\": "lib/shop-integration-core/src/"
        }
    },
    "scripts": {
        "test": "php -d memory_limit=1G vendor/bin/pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "sync-core": "sh bin/sync-core.sh",
        "lint": "phpcs -n",
        "lint:warnings": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
